# PowerContext：任务状态服务。默认 loopback 不启用鉴权。
POWERCONTEXT_URL=http://127.0.0.1:8010
# POWERCONTEXT_TOKEN=
POWERCONTEXT_SCOPE_KEY=sdd-books-demo

# MiniMax：仅在 run --mode live 时需要。
# M Plan / Token Plan 订阅 Key 使用 Anthropic 兼容端点；
# 按量计费 API Key 可改成 MINIMAX_PROTOCOL=openai + https://api.minimax.io/v1
MINIMAX_PROTOCOL=anthropic
MINIMAX_BASE_URL=https://api.minimax.cn/anthropic
MINIMAX_MODEL=MiniMax-M3.1-Flash
# MINIMAX_API_KEY=
